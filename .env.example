APP_NAME=API Integration Lab
APP_VERSION=0.2.0
LOG_LEVEL=INFO

GITHUB_API_BASE=https://api.github.com
GITHUB_TIMEOUT_SECONDS=5.0
GITHUB_MAX_RETRIES=2
GITHUB_BACKOFF_SECONDS=0.5

# Optional. Never commit a real token.
GITHUB_TOKEN=

ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=15
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_BACKOFF_SECONDS=0.5
ANTHROPIC_MAX_TOKENS=300

GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2
GEMINI_BACKOFF_SECONDS=0.5
GEMINI_MAX_TOKENS=120

WEBHOOK_SECRET=

DATABASE_PATH=data/api_metrics.db
